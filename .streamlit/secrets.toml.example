# ==============================================================================
# Neon PostgreSQL Database Credentials Template
# ==============================================================================
# For Local Development:
#   Copy this file to .streamlit/secrets.toml and replace with your Neon credentials.
#
# For Streamlit Community Cloud:
#   In your deployed app dashboard, go to "Settings" -> "Secrets",
#   and paste the four keys below with your values.
# ==============================================================================

DB_HOST = "ep-example-pooler.us-east-2.aws.neon.tech"
DB_NAME = "neondb"
DB_USER = "neondb_owner"
DB_PASS = "your_secure_password_here"
